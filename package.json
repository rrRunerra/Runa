{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.2.4"
  },
  "pnpm": {
    "overrides": {
      "got@<11.8.5": ">=11.8.5",
      "http-cache-semantics@<4.1.1": ">=4.1.1",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "undici@<6.23.0": ">=6.23.0",
      "hono@<4.11.7": ">=4.11.7",
      "hono@<4.11.10": ">=4.11.10",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "hono@<4.12.4": ">=4.12.4",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "hono@<4.12.7": ">=4.12.7",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "undici@>=7.17.0 <7.24.0": ">=7.24.0",
      "file-type@>=20.0.0 <=21.3.1": ">=21.3.2",
      "next@>=16.0.0-beta.0 <16.1.7": ">=16.1.7",
      "next@>=16.0.1 <16.1.7": ">=16.1.7",
      "effect@<3.20.0": ">=3.20.0"
    }
  }
}
