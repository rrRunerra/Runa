{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenvx run -- turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "rrAppCreate": "node ./rrScripts/rrCreateApp.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.11.1",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "react": "19.2.7"
  }
}
