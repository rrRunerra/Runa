{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenvx run -- turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.68.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.2.4"
  }
}
