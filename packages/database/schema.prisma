generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                   String                @id @default(nanoid())
    createdAt            DateTime              @default(now())
    updatedAt            DateTime              @updatedAt
    email                String                @unique
    username             String                @unique
    passwordHash         String
    passwordChangedAt    DateTime?
    privacy              Json?                 @db.Json
    permissions          Int[]                 @default([])

    displayName          String?
    avatarUrl            String?
    bannerUrl            String?
    sidebarCardBackgroundUrl String?
    profileSettings      Json?                 @db.Json
    apiKeys              ApiKey[]
    connections          Connections[]
    animeList            AquilaAnimeUserList[]
    mangaList            AquilaMangaUserList[]
    aquilaMovieUserLists AquilaMovieUserList[]
    aquilaTvUserLists    AquilaTvUserList[]
    favorites            Favorite[]
    gameList             AquilaGameUserList[]
    bookList             AquilaBookUserList[]

    @@index([id])
    @@index([username])
}

model ApiKey {
    id         String    @id @default(nanoid())
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    keyHash    String
    keyPrefix  String
    name       String
    lastUsedAt DateTime?
    userId     String
    user       User      @relation(fields: [userId], references: [id])

    @@unique([keyPrefix])
    @@index([userId])
    @@index([keyPrefix])
}

enum ConnectionLinkedTo {
    LYNX
    AQUILA
}

model Connections {
    id             String              @id @default(nanoid())
    username       String
    connectionId   String?
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt
    provider       ConnectionProvider
    linkedTo       ConnectionLinkedTo?
    linkedUsername String?
    accessToken    String?
    expiresAt      DateTime?
    refreshToken   String?
    user           User                @relation(fields: [username], references: [username])
    private        Boolean             @default(false)
    metadata       Json?               @db.Json

    @@unique([username, provider])
    @@index([username])
}

model LynxHomeworkExists {
    id             Int    @id @default(autoincrement())
    superID        String
    title          String
    forumChannelID String
    forumID        String
    guilID         String

    @@index([superID])
    @@index([forumChannelID])
    @@index([forumID])
    @@index([guilID])
}

model LynxHomeWorkChannels {
    guildId  String @id
    channels Json   @db.Json

    @@index([guildId])
}

model LynxRngRigConfig {
    id             String @id @default(nanoid())
    ignoredNumbers Json   @db.Json
}

model LynxKickHistory {
    id        String   @id @default(nanoid())
    userId    String
    guildId   String
    moderator String
    reason    String
    createdAt DateTime @default(now())

    @@index([userId])
    @@index([guildId])
}

model LynxBanHistory {
    id        String    @id @default(nanoid())
    userId    String
    guildId   String
    moderator String
    reason    String
    duration  Int
    until     DateTime?
    createdAt DateTime  @default(now())

    @@index([userId])
    @@index([guildId])
}

model LynxClearBatch {
    id          String               @id @default(nanoid())
    guildId     String
    channelId   String
    moderatorId String
    createdAt   DateTime             @default(now())
    messages    LynxClearedMessage[]

    @@index([guildId])
    @@index([channelId])
}

model LynxClearedMessage {
    id          String         @id @default(nanoid())
    batchId     String
    authorId    String
    username    String
    avatarUrl   String?
    content     String?
    embeds      Json?          @db.Json
    attachments Json?          @db.Json
    createdAt   DateTime       @default(now())
    timestamp   DateTime
    batch       LynxClearBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

    @@index([batchId])
}

model LynxLogs {
    id        Int         @id @default(autoincrement())
    type      LynxLogType
    message   String
    context   String?
    metadata  Json?       @db.Json
    createdAt DateTime    @default(now())
}

enum ConnectionProvider {
    ANILIST
    MAL
    SIMKL
    DISCORD
}

enum LynxLogType {
    INFO
    WARN
    ERROR
    DEBUG
    VERBOSE
}

// AQUILA

model AquilaAnime {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique
    malId     Int? @unique

    titleEnglish String? @db.Text
    titleRomaji  String? @db.Text
    titleNative  String? @db.Text

    coverImageLarge      String? @db.Text
    coverImageExtraLarge String? @db.Text

    bannerImage String? @db.Text
    description String? @db.Text

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    endDateYear  Int?
    endDateMonth Int?
    endDateDay   Int?

    season     String?
    seasonYear Int?

    episodes Int?
    duration Int?
    genres   String[] @db.Text
    tags     Json?    @db.Json

    source  String?
    format  AnimeFormat @default(UNKNOWN)
    status  AnimeStatus @default(NOT_YET_RELEASED)
    isAdult Boolean?    @db.Boolean

    relations  Json?    @db.Json
    characters Json?    @db.Json
    studios    String[] @db.Text

    averageScore      Int?
    popularity        Int?
    favourites        Int?
    trending          Int?
    meanScore         Int?
    synonyms          String[]    @db.Text
    hashtag           String?
    countryOfOrigin   String?
    nextAiringEpisode Json?       @db.Json
    trailers          Json?       @db.Json

    locked          Boolean               @default(false)
    updatedAt       DateTime              @updatedAt
    aquilaUserLists AquilaAnimeUserList[]

    @@index([anilistId])
    @@index([malId])
    @@index([titleEnglish])
}

model AquilaAnimeUserList {
    id        Int             @id @default(autoincrement())
    username  String
    animeId   Int
    malId     Int?
    anilistId Int?
    status    AnimeListStatus @default(PLANNING)
    progress  Int?
    score     Int?
    notes     String?         @db.Text
    rewatched Int?
    private   Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user  User        @relation(fields: [username], references: [username])
    anime AquilaAnime @relation(fields: [animeId], references: [anilistId])

    @@unique([username, animeId])
    @@index([username])
    @@index([animeId])
}

enum AnimeFormat {
    TV
    TV_SHORT
    MOVIE
    SPECIAL
    OVA
    ONA
    MUSIC
    UNKNOWN
}

enum AnimeStatus {
    FINISHED
    RELEASING
    NOT_YET_RELEASED
    CANCELLED
}

enum AnimeListStatus {
    PLANNING
    WATCHING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaManga {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique
    malId     Int? @unique

    titleEnglish String? @db.Text
    titleRomaji  String? @db.Text
    titleNative  String? @db.Text

    coverImageLarge      String? @db.Text
    coverImageExtraLarge String? @db.Text

    bannerImage String? @db.Text
    description String? @db.Text

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    endDateYear  Int?
    endDateMonth Int?
    endDateDay   Int?

    chapters Int?
    volumes  Int?

    genres String[] @db.Text
    tags   Json?    @db.Json

    source  String?
    format  MangaFormat @default(UNKNOWN)
    status  MangaStatus @default(NOT_YET_RELEASED)
    isAdult Boolean?    @db.Boolean

    relations  Json?    @db.Json
    characters Json?    @db.Json
    studios    String[] @db.Text

    averageScore      Int?
    popularity        Int?
    favourites        Int?
    trending          Int?
    meanScore         Int?
    synonyms          String[]    @db.Text
    hashtag           String?
    countryOfOrigin   String?

    locked          Boolean               @default(false)
    updatedAt       DateTime              @updatedAt
    aquilaUserLists AquilaMangaUserList[]

    @@index([anilistId])
    @@index([malId])
    @@index([titleEnglish])
}

model AquilaMangaUserList {
    id        Int             @id @default(autoincrement())
    username  String
    mangaId   Int
    malId     Int?
    anilistId Int?
    status    MangaListStatus @default(PLANNING)
    chapters  Int?
    volumes   Int?
    score     Int?
    notes     String?         @db.Text
    reread    Int?
    private   Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user  User        @relation(fields: [username], references: [username])
    manga AquilaManga @relation(fields: [mangaId], references: [anilistId])

    @@unique([username, mangaId])
    @@index([username])
    @@index([mangaId])
}

enum MangaFormat {
    MANGA
    NOVEL
    ONE_SHOT
    UNKNOWN
}

enum MangaStatus {
    FINISHED
    RELEASING
    NOT_YET_RELEASED
    CANCELLED
}

enum MangaListStatus {
    PLANNING
    READING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaMovie {
    id     Int @id @default(autoincrement())
    tvdbId Int @unique

    titleEnglish String?
    titleRomaji  String?

    coverImage  String?
    bannerImage String?
    description String?

    status  String?
    runtime Int?

    genres  String[] @db.Text
    studios String[] @db.Text

    cast Json? @db.Json

    originalCountry  String?
    originalLanguage String?
    contentRating    String?
    trailers         Json?    @db.Json

    locked               Boolean               @default(false)
    updatedAt            DateTime              @updatedAt
    aquilaMovieUserLists AquilaMovieUserList[]

    @@index([tvdbId])
}

model AquilaTv {
    id     Int @id @default(autoincrement())
    tvdbId Int @unique

    titleEnglish String?
    titleRomaji  String?

    coverImage  String?
    bannerImage String?
    description String?

    status           String?
    originalCountry  String?
    originalLanguage String?
    tvType           String?
    subgenre         String?
    averageRuntime   Int?

    genres  String[] @db.Text
    studios String[] @db.Text

    cast     Json? @db.Json
    seasons  Json? @db.Json
    trailers Json? @db.Json

    contentRating    String?

    locked          Boolean            @default(false)
    updatedAt       DateTime           @updatedAt
    aquilaUserLists AquilaTvUserList[]

    @@index([tvdbId])
}

enum TvListStatus {
    WATCHING
    PLANNING
    COMPLETED
    DROPPED
}

model AquilaTvUserList {
    id        Int          @id @default(autoincrement())
    username  String
    tvdbId    Int
    status    TvListStatus @default(PLANNING)
    score     Int?
    notes     String?      @db.Text
    rewatched Int?
    private   Boolean      @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user            User                     @relation(fields: [username], references: [username])
    tv              AquilaTv                 @relation(fields: [tvdbId], references: [tvdbId])
    watchedEpisodes AquilaTvWatchedEpisode[]

    @@unique([username, tvdbId])
    @@index([username])
    @@index([tvdbId])
}

model AquilaTvWatchedEpisode {
    id         Int      @id @default(autoincrement())
    listId     Int
    seasonNum  Int
    episodeNum Int
    watchedAt  DateTime @default(now())

    list AquilaTvUserList @relation(fields: [listId], references: [id], onDelete: Cascade)

    @@unique([listId, seasonNum, episodeNum])
    @@index([listId])
}

enum MovieListStatus {
    COMPLETED
    PLANNING
    DROPPED
}

model AquilaMovieUserList {
    id        Int             @id @default(autoincrement())
    username  String
    tvdbId    Int
    status    MovieListStatus @default(PLANNING)
    score     Int?
    notes     String?         @db.Text
    rewatched Int?
    private   Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user  User        @relation(fields: [username], references: [username])
    movie AquilaMovie @relation(fields: [tvdbId], references: [tvdbId])

    @@unique([username, tvdbId])
    @@index([username])
    @@index([tvdbId])
}

enum FavoriteType {
    ANIME
    MANGA
    MOVIE
    TV
    BOOK
    GAME
    USER
}

model Favorite {
    id        String       @id @default(nanoid())
    userId    String
    type      FavoriteType
    mediaId   String
    createdAt DateTime     @default(now())

    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, type, mediaId])
    @@index([userId])
}

enum GameListStatus {
    PLANNING
    PLAYING
    COMPLETED
    ON_HOLD
    DROPPED
}

enum BookListStatus {
    PLANNING
    READING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaGame {
    id        Int  @id @default(autoincrement())
    rawgId    Int  @unique

    titleString String? @db.Text

    coverImage      String? @db.Text
    description     String? @db.Text

    releasedYear  Int?
    releasedMonth Int?
    releasedDay   Int?

    genres  String[] @db.Text
    platforms String[] @db.Text
    developers String[] @db.Text
    publishers String[] @db.Text

    averageScore Float?
    popularity   Int?

    locked          Boolean               @default(false)
    updatedAt       DateTime              @updatedAt
    aquilaUserLists AquilaGameUserList[]

    @@index([rawgId])
    @@index([titleString])
}

model AquilaGameUserList {
    id        Int             @id @default(autoincrement())
    username  String
    gameId    Int
    status    GameListStatus @default(PLANNING)
    progress  Int?            // Hours played
    score     Int?
    notes     String?         @db.Text
    private   Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user  User        @relation(fields: [username], references: [username])
    game  AquilaGame  @relation(fields: [gameId], references: [rawgId])

    @@unique([username, gameId])
    @@index([username])
    @@index([gameId])
}

model AquilaBook {
    id            Int      @id @default(autoincrement())
    openLibraryId String   @unique

    titleString   String?  @db.Text
    coverImage    String?  @db.Text
    description   String?  @db.Text

    publishYear   Int?

    subjects      String[] @db.Text
    authors       String[] @db.Text
    publishers    String[] @db.Text

    pages         Int?
    chapters      Int?

    locked          Boolean               @default(false)
    updatedAt       DateTime              @updatedAt
    aquilaUserLists AquilaBookUserList[]

    @@index([openLibraryId])
    @@index([titleString])
}

model AquilaBookUserList {
    id        Int             @id @default(autoincrement())
    username  String
    bookId    String
    status    BookListStatus  @default(PLANNING)
    chapters  Int?
    volumes   Int?
    score     Int?
    notes     String?         @db.Text
    private   Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user  User        @relation(fields: [username], references: [username])
    book  AquilaBook  @relation(fields: [bookId], references: [openLibraryId])

    @@unique([username, bookId])
    @@index([username])
    @@index([bookId])
}

