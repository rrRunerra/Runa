generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
    provider = "postgresql"
}

model User {
    id                String    @id @default(nanoid())
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    email             String    @unique
    username          String    @unique
    passwordHash      String
    passwordChangedAt DateTime?
    privacy           Json?     @db.Json
    permissions       Int[]     @default([])

    displayName              String?
    avatarUrl                String?
    bannerUrl                String?
    sidebarCardBackgroundUrl String?
    profileSettings          Json?                  @db.Json
    apiKeys                  ApiKey[]
    connections              Connections[]
    animeList                AquilaAnimeUserList[]
    mangaList                AquilaMangaUserList[]
    aquilaMovieUserLists     AquilaMovieUserList[]
    aquilaTvUserLists        AquilaTvUserList[]
    favorites                Favorite[]
    gameList                 AquilaGameUserList[]
    bookList                 AquilaBookUserList[]
    userStats                UserStats[]
    polarisBookmarks         PolarisUserBookMarks[]
    emailAccounts            UserEmailAccount[]
    cannedResponses          CannedResponse[]
    devices                  Device[]
    notifications            Notification[]
    laceraFiles              LaceraFile[]
    laceraShares             LaceraShare[]
    vaultPinHash             String?

    // MFA Configuration Fields
    totpSecret      String?
    totpEnabled     Boolean   @default(false)
    emailMfaEnabled Boolean   @default(false)
    backupCodes     String[]  @default([])
    passkeys        Passkey[]

    // Encryption Keys
    userPublicKey           String?
    encryptedUserPrivateKey String?
    userMlKemPublicKey      String?

    @@index([id])
    @@index([username])
    @@index([email])
}

model LaceraFile {
    id         String   @id @default(nanoid())
    key        String   @unique
    userId     String
    isPublic   Boolean  @default(false)
    wrappedKey String
    createdAt  DateTime @default(now())

    isFolder   Boolean  @default(false)
    name       String   // Encrypted name (AES-GCM base64 format)
    size       Int?     // Size of file (optional, folders have null)
    type       String?  // Encrypted mime-type
    parentId   String?  // Folder hierarchy parent
    isTrash    Boolean  @default(false)
    isVault    Boolean  @default(false)

    user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    parent     LaceraFile?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children   LaceraFile[]  @relation("FolderHierarchy")
    shares     LaceraShare[] @relation("FileShares")

    @@index([userId])
    @@index([key])
    @@index([parentId])
}

model LaceraShare {
    id         String   @id @default(nanoid())
    fileId     String
    userId     String   // Recipient user ID
    wrappedKey String   // Symmetric key wrapped with recipient's public key
    allowEdit  Boolean  @default(true)
    createdAt  DateTime @default(now())

    file       LaceraFile @relation("FileShares", fields: [fileId], references: [id], onDelete: Cascade)
    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([fileId, userId])
    @@index([userId])
    @@index([fileId])
}

model Passkey {
    id         String   @id // The base64url encoded credential ID
    publicKey  String // The base64url encoded public key
    counter    Int // Credential counter
    transports String[] // Transports (usb, nfc, ble, internal, hybrid)
    name       String? // Nickname/label for the passkey
    createdAt  DateTime @default(now())
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model ApiKey {
    id         String    @id @default(nanoid())
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    keyHash    String
    keyPrefix  String
    name       String
    app        String    @default("Polaris")
    lastUsedAt DateTime?
    expiresAt  DateTime?
    userId     String
    user       User      @relation(fields: [userId], references: [id])

    @@unique([keyPrefix])
    @@index([userId])
    @@index([keyPrefix])
}

enum ConnectionLinkedTo {
    LYNX
    AQUILA
}

model Connections {
    id             String              @id @default(nanoid())
    username       String
    connectionId   String?
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt
    provider       ConnectionProvider
    linkedTo       ConnectionLinkedTo?
    linkedUsername String?
    accessToken    String?
    expiresAt      DateTime?
    refreshToken   String?
    user           User                @relation(fields: [username], references: [username])
    private        Boolean             @default(false)
    metadata       Json?               @db.Json

    @@unique([username, provider])
    @@index([username])
}

model LynxHomeworkExists {
    id             Int    @id @default(autoincrement())
    superID        String
    title          String
    forumChannelID String
    forumID        String
    guilID         String

    @@index([superID])
    @@index([forumChannelID])
    @@index([forumID])
    @@index([guilID])
}

model LynxHomeWorkChannels {
    guildId  String @id
    channels Json   @db.Json

    @@index([guildId])
}

model LynxRngRigConfig {
    id             String @id @default(nanoid())
    ignoredNumbers Json   @db.Json
}

model LynxKickHistory {
    id        String   @id @default(nanoid())
    userId    String
    guildId   String
    moderator String
    reason    String
    createdAt DateTime @default(now())

    @@index([userId])
    @@index([guildId])
}

model LynxBanHistory {
    id        String    @id @default(nanoid())
    userId    String
    guildId   String
    moderator String
    reason    String
    duration  Int
    until     DateTime?
    createdAt DateTime  @default(now())

    @@index([userId])
    @@index([guildId])
}

model LynxClearBatch {
    id          String               @id @default(nanoid())
    guildId     String
    channelId   String
    moderatorId String
    createdAt   DateTime             @default(now())
    messages    LynxClearedMessage[]

    @@index([guildId])
    @@index([channelId])
}

model LynxClearedMessage {
    id          String         @id @default(nanoid())
    batchId     String
    authorId    String
    username    String
    avatarUrl   String?
    content     String?
    embeds      Json?          @db.Json
    attachments Json?          @db.Json
    createdAt   DateTime       @default(now())
    timestamp   DateTime
    batch       LynxClearBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

    @@index([batchId])
}

model LynxLogs {
    id        Int         @id @default(autoincrement())
    type      LynxLogType
    message   String
    context   String?
    metadata  Json?       @db.Json
    createdAt DateTime    @default(now())
}

enum ConnectionProvider {
    ANILIST
    MAL
    SIMKL
    DISCORD
    TRAKT
}

enum LynxLogType {
    INFO
    WARN
    ERROR
    DEBUG
    VERBOSE
}

// AQUILA

model AquilaAnime {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique
    malId     Int? @unique

    titleEnglish String? @db.Text
    titleRomaji  String? @db.Text
    titleNative  String? @db.Text

    coverImageLarge String? @db.Text

    bannerImage String? @db.Text
    description String? @db.Text

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    endDateYear  Int?
    endDateMonth Int?
    endDateDay   Int?

    season     String?
    seasonYear Int?

    episodes Int?
    duration Int?
    genres   String[] @db.Text
    tags     Json?    @db.Json

    source  String?
    format  AnimeFormat @default(UNKNOWN)
    status  AnimeStatus @default(NOT_YET_RELEASED)
    isAdult Boolean?    @db.Boolean

    averageScore      Int?
    favourites        Int?
    synonyms          String[] @db.Text
    hashtag           String?
    countryOfOrigin   String?
    nextAiringEpisode Json?    @db.Json
    trailers          Json?    @db.Json

    locked          Boolean               @default(false)
    anilistUpdatedAt Int?
    createdAt       DateTime              @default(now())
    updatedAt       DateTime              @updatedAt

    localPopularity         Int      @default(0)
    localFavoritesCount     Int      @default(0)
    localAverageScore       Float    @default(0)
    localStatusDistribution Json     @default("{}") @db.Json
    localScoreDistribution  Json     @default("{}") @db.Json
    localTotalScoreSum      Int      @default(0)
    localScoredCount        Int      @default(0)
    aquilaUserLists AquilaAnimeUserList[]
    animeCharacters AquilaAnimeCharacter[]
    animeStudios    AquilaAnimeStudio[]
    animeRelations         AquilaMediaRelation[]
    relatedAnimeRelations  AquilaMediaRelation[] @relation("MediaRelationFrom")

    @@index([anilistId])
    @@index([malId])
    @@index([titleEnglish])
}

model AquilaCharacter {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique

    nameFirst          String? @db.Text
    nameMiddle         String? @db.Text
    nameLast           String? @db.Text
    nameNative         String? @db.Text
    nameAlternative     String[] @db.Text
    nameAlternativeSpoiler String[] @db.Text

    image String? @db.Text

    description String? @db.Text
    gender      String?
    age         String?
    bloodType   String?

    dateOfBirthYear  Int?
    dateOfBirthMonth Int?
    dateOfBirthDay   Int?

    animeCharacters AquilaAnimeCharacter[]
    mangaCharacters AquilaMangaCharacter[]
    movieCharacters AquilaMovieCharacter[]
    tvCharacters    AquilaTvCharacter[]

    @@index([anilistId])
}

model AquilaAnimeCharacter {
    animeId      Int
    characterId  Int
    voiceActorId Int?

    role  String?
    order Int?

    anime      AquilaAnime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
    character  AquilaCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
    voiceActor AquilaActor?    @relation(fields: [voiceActorId], references: [id], onDelete: SetNull)

    @@id([animeId, characterId])
    @@index([animeId])
    @@index([characterId])
    @@index([voiceActorId])
}

model AquilaStudio {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique

    name              String?  @db.Text
    isAnimationStudio Boolean? @default(false)
    siteUrl           String?  @db.Text

    animeStudios AquilaAnimeStudio[]
    mangaStudios AquilaMangaStudio[]

    @@index([anilistId])
}

model AquilaAnimeStudio {
    animeId  Int
    studioId Int
    isMain   Boolean? @default(false)

    anime  AquilaAnime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
    studio AquilaStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)

    @@id([animeId, studioId])
    @@index([animeId])
    @@index([studioId])
}

model AquilaMediaRelation {
    id             Int     @id @default(autoincrement())
    animeId        Int?
    mangaId        Int?
    relatedAnimeId Int?
    relatedMangaId Int?
    relationType   String?

    anime         AquilaAnime? @relation(fields: [animeId], references: [id], onDelete: Cascade)
    manga         AquilaManga? @relation("MediaRelationManga", fields: [mangaId], references: [id])
    relatedAnime  AquilaAnime? @relation("MediaRelationFrom", fields: [relatedAnimeId], references: [id])
    relatedManga  AquilaManga? @relation("MediaRelationRelatedManga", fields: [relatedMangaId], references: [id])

    @@index([animeId])
    @@index([mangaId])
}

model AquilaAnimeUserList {
    id       Int             @id @default(autoincrement())
    username String
    animeId  Int
    status   AnimeListStatus @default(PLANNING)
    progress Int?
    score    Int?
    notes    String?         @db.Text
    rewatched Int?
    private  Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user  User        @relation(fields: [username], references: [username])
    anime AquilaAnime @relation(fields: [animeId], references: [id])

    @@unique([username, animeId])
    @@index([username])
    @@index([animeId])
}

enum AnimeFormat {
    TV
    TV_SHORT
    MOVIE
    SPECIAL
    OVA
    ONA
    MUSIC
    UNKNOWN
}

enum AnimeStatus {
    FINISHED
    RELEASING
    NOT_YET_RELEASED
    CANCELLED
}

enum AnimeListStatus {
    PLANNING
    WATCHING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaManga {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique
    malId     Int? @unique

    titleEnglish String? @db.Text
    titleRomaji  String? @db.Text
    titleNative  String? @db.Text

    coverImageLarge String? @db.Text

    bannerImage String? @db.Text
    description String? @db.Text

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    endDateYear  Int?
    endDateMonth Int?
    endDateDay   Int?

    chapters Int?
    volumes  Int?

    genres String[] @db.Text
    tags   Json?    @db.Json

    source  String?
    format  MangaFormat @default(UNKNOWN)
    status  MangaStatus @default(NOT_YET_RELEASED)
    isAdult Boolean?    @db.Boolean

    averageScore    Int?
    favourites      Int?
    synonyms        String[] @db.Text
    hashtag         String?
    countryOfOrigin String?

    locked    Boolean               @default(false)
    anilistUpdatedAt Int?
    createdAt DateTime              @default(now())
    updatedAt DateTime              @updatedAt

    localPopularity         Int      @default(0)
    localFavoritesCount     Int      @default(0)
    localAverageScore       Float    @default(0)
