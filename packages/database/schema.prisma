    @@index([mangaId])
    @@index([characterId])
}

model AquilaMangaStudio {
    mangaId  Int
    studioId Int
    isMain   Boolean? @default(false)

    manga  AquilaManga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)
    studio AquilaStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)

    @@id([mangaId, studioId])
    @@index([mangaId])
    @@index([studioId])
}

model AquilaMangaUserList {
    id       Int             @id @default(autoincrement())
    username String
    mangaId  Int
    status   MangaListStatus @default(PLANNING)
    chapters Int?
    volumes  Int?
    score    Int?
    notes    String?         @db.Text
    reread   Int?
    private  Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user  User        @relation(fields: [username], references: [username])
    manga AquilaManga @relation(fields: [mangaId], references: [id])

    @@unique([username, mangaId])
    @@index([username])
    @@index([mangaId])
}

enum MangaFormat {
    MANGA
    NOVEL
    ONE_SHOT
    UNKNOWN
}

enum MangaStatus {
    FINISHED
    RELEASING
    NOT_YET_RELEASED
    CANCELLED
}

enum MangaListStatus {
    PLANNING
    READING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaMovie {
    id     Int @id @default(autoincrement())
    tvdbId Int @unique
    tmdbId Int?
    imdbId String?

    titleEnglish String? @db.Text
    titleRomaji  String? @db.Text
    titleNative  String? @db.Text

    coverImage  String? @db.Text
    bannerImage String? @db.Text
    description String? @db.Text
    slug        String?

    releaseDate String?
    status      String?
    runtime     Int?
    budget      String?
    boxOffice   String?

    genres  String[] @db.Text
    studios String[] @db.Text

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    trailers Json? @db.Json

    originalCountry  String?
    originalLanguage String?
    contentRating    String?

    locked               Boolean               @default(false)
    createdAt            DateTime              @default(now())
    updatedAt            DateTime              @updatedAt

    localPopularity         Int      @default(0)
    localFavoritesCount     Int      @default(0)
    localAverageScore       Float    @default(0)
    localStatusDistribution Json     @default("{}") @db.Json
    localScoreDistribution  Json     @default("{}") @db.Json
    localTotalScoreSum      Int      @default(0)
    localScoredCount        Int      @default(0)
    aquilaMovieUserLists AquilaMovieUserList[]
    movieCharacters      AquilaMovieCharacter[]

    @@index([tvdbId])
    @@index([tmdbId])
}

model AquilaTv {
