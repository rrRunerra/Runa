model AquilaTvWatchedEpisode {
    id         Int      @id @default(autoincrement())
    listId     Int
    seasonNum  Int
    episodeNum Int
    watchedAt  DateTime @default(now())

    list AquilaTvUserList @relation(fields: [listId], references: [id], onDelete: Cascade)

    @@unique([listId, seasonNum, episodeNum])
    @@index([listId])
}

enum MovieListStatus {
    COMPLETED
    PLANNING
    DROPPED
}

model AquilaMovieUserList {
    id       Int             @id @default(autoincrement())
    username String
    movieId  Int
    status   MovieListStatus @default(PLANNING)
    score    Int?
    notes    String?         @db.Text
    rewatched Int?
    private  Boolean         @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.Json

    user  User        @relation(fields: [username], references: [username])
    movie AquilaMovie @relation(fields: [movieId], references: [id])

    @@unique([username, movieId])
    @@index([username])
    @@index([movieId])
}

enum FavoriteType {
    ANIME
    MANGA
    MOVIE
    TV
    BOOK
    GAME
    USER
}

model Favorite {
    id        String       @id @default(nanoid())
    userId    String
    type      FavoriteType
    mediaId   String
    createdAt DateTime     @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, type, mediaId])
    @@index([userId])
}

enum GameListStatus {
    PLANNING
    PLAYING
    COMPLETED
    ON_HOLD
    DROPPED
}

enum BookListStatus {
    PLANNING
    READING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaGame {
    id     Int @id @default(autoincrement())
    rawgId Int @unique

    titleString String? @db.Text
    titleNative String? @db.Text
    slug        String?

    coverImage      String? @db.Text
    backgroundImage String? @db.Text
    description     String? @db.Text

    releasedYear  Int?
    releasedMonth Int?
    releasedDay   Int?

    released String?

    genres      String[] @db.Text
    platforms   String[] @db.Text
    developers  String[] @db.Text
    publishers  String[] @db.Text
    tags        Json?    @db.Json

    averageScore Float?
    popularity   Int?
    metacritic   Int?
    rating       Float?
    ratingsCount Int?
    esrbRating   String?

    locked          Boolean              @default(false)
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt

    localPopularity         Int      @default(0)
    localFavoritesCount     Int      @default(0)
    localAverageScore       Float    @default(0)
    localStatusDistribution Json     @default("{}") @db.Json
    localScoreDistribution  Json     @default("{}") @db.Json
    localTotalScoreSum      Int      @default(0)
    localScoredCount        Int      @default(0)
    aquilaUserLists AquilaGameUserList[]

    @@index([rawgId])
    @@index([titleString])
}

model AquilaGameUserList {
    id       Int            @id @default(autoincrement())
    username String
    gameId   Int
    status   GameListStatus @default(PLANNING)
    progress Int? // Hours played
    score    Int?
    notes    String?        @db.Text
    private  Boolean        @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User       @relation(fields: [username], references: [username])
    game AquilaGame @relation(fields: [gameId], references: [id])

    @@unique([username, gameId])
    @@index([username])
    @@index([gameId])
}

model AquilaBook {
    id           Int    @id @default(autoincrement())
    googleBookId String @unique

    titleString String? @db.Text
    subtitle    String? @db.Text
    coverImage  String? @db.Text
    description String? @db.Text

    publishedYear  Int?
    publishedMonth Int?
    publishedDay   Int?
    publishedDate  String?

    subjects   String[] @db.Text
    authors    String[] @db.Text
    artists    String[] @db.Text
    publishers String[] @db.Text

    pages    Int?
    pageCount Int?
    chapters Int?

    averageRating       Float?
    ratingsCount        Int?
    language            String?
    isbn10              String?
    isbn13              String?
    previewLink         String? @db.Text
    infoLink            String? @db.Text
    buyLink             String? @db.Text
    retailPrice         Float?
    retailPriceCurrency String?
    maturityRating      String?
    publisher           String? @db.Text

    locked          Boolean              @default(false)
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt

    localPopularity         Int      @default(0)
    localFavoritesCount     Int      @default(0)
    localAverageScore       Float    @default(0)
    localStatusDistribution Json     @default("{}") @db.Json
    localScoreDistribution  Json     @default("{}") @db.Json
    localTotalScoreSum      Int      @default(0)
    localScoredCount        Int      @default(0)
    aquilaUserLists AquilaBookUserList[]

    @@index([googleBookId])
    @@index([titleString])
}

model AquilaBookUserList {
    id       Int            @id @default(autoincrement())
    username String
    bookId   Int
    status   BookListStatus @default(PLANNING)
    chapters Int?
    volumes  Int?
    score    Int?
    notes    String?        @db.Text
    private  Boolean        @default(false)

    startDate Int?
    endDate   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User       @relation(fields: [username], references: [username])
    book AquilaBook @relation(fields: [bookId], references: [id])

    @@unique([username, bookId])
    @@index([username])
    @@index([bookId])
}

model UserStats {
    id        String   @id @default(nanoid())
    userId    String
    mediaType String // "anime" | "manga" | "movie" | "tv" | "game" | "book"
    updatedAt DateTime @updatedAt
    statsData Json     @db.Json

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, mediaType])
    @@index([userId])
}

model PolarisUserBookMarks {
    id              String   @id @default(nanoid())
    userId          String
    name            String
    description     String
    redirect        String
    stars           Json     @db.Json
    connections     Json     @db.Json
    icon            String?
    connectionColor String?
    starColor       String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model UserEmailAccount {
    id                String         @id @default(nanoid())
    username          String
    accountName       String
    color             String         @default("#8B00FF")
    senderName        String
    emailAddress      String
    loginEmail        String?
    replyToAddress    String?
    organization      String?
    signatureText     String?
    useHtmlSignature  Boolean        @default(false)
    encryptedPassword String
    encryptionIv      String
    imapHost          String
    imapPort          Int
    imapSecure        Boolean
    smtpHost          String
    smtpPort          Int
    smtpSecure        Boolean
    createdAt         DateTime       @default(now())
    updatedAt         DateTime       @updatedAt
    user              User           @relation(fields: [username], references: [username], onDelete: Cascade)
    emailMessages     EmailMessage[]

    @@index([username])
}

model EmailMessage {
    id                 String            @id @default(nanoid())
    userEmailAccountId String
    uid                Int
    messageId          String?
    subject            String?
    from               String?
    to                 String?
    cc                 String?
    bcc                String?
    date               DateTime?
    bodyText           String?
    bodyHtml           String?
    read               Boolean           @default(false)
    flagged            Boolean           @default(false)
    folder             String
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    encryptedKey       Json?             @db.Json
    labels             String[]          @default([])
    emailAccount       UserEmailAccount  @relation(fields: [userEmailAccountId], references: [id], onDelete: Cascade)
    attachments        EmailAttachment[]

    @@unique([userEmailAccountId, folder, uid])
    @@index([userEmailAccountId])
}

model EmailAttachment {
    id             String       @id @default(nanoid())
    emailMessageId String
    filename       String
    contentType    String
    size           Int
    content        Bytes
    createdAt      DateTime     @default(now())
    emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

    @@index([emailMessageId])
}

model Device {
    id                 String   @id @default(nanoid())
    userId             String
    deviceName         String
    userAgent          String?
    lastActiveAt       DateTime @default(now())
    identityKey        String
    signedPreKey       String
    encryptedMasterKey String?
    mlKemIdentityKey   String?
    user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    preKeys            PreKey[]

    @@index([userId])
}

model PreKey {
    id       String @id @default(nanoid())
    deviceId String
    key      String
    device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

    @@index([deviceId])
}

model Notification {
    id        String             @id @default(nanoid())
    userId    String
    title     String
    message   String
    type      NotificationType   @default(INFO)
    status    NotificationStatus @default(PENDING)
    metadata  Json?              @db.Json
    createdAt DateTime           @default(now())
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

enum NotificationType {
    INFO
    CONFIRMATION
    PROMPT
    INTERACTIVE
}

enum NotificationStatus {
    PENDING
    APPROVED
    DENIED
    READ
}

model CannedResponse {
    id           String   @id @default(nanoid())
    username     String
    name         String
    subject      String?
    bodyText     String
    encryptedKey Json?    @db.Json
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    user         User     @relation(fields: [username], references: [username], onDelete: Cascade)

    @@index([username])
}
