model AquilaMangaCharacter {
    mangaId     Int
    characterId Int

    role  String?
    order Int?

    manga     AquilaManga     @relation(fields: [mangaId], references: [id], onDelete: Cascade)
    character AquilaCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

