    @@index([tvdbId])
    @@index([tmdbId])
}

model AquilaActor {
    id             Int  @id @default(autoincrement())
    peopleId       Int? @unique
    anilistStaffId Int? @unique

    name       String? @db.Text
    personName String? @db.Text
    image      String? @db.Text
    peopleType String?

    movieCharacters AquilaMovieCharacter[]
    tvCharacters    AquilaTvCharacter[]
    animeCharacters AquilaAnimeCharacter[]

    @@index([peopleId])
    @@index([anilistStaffId])
