    titleEnglish String? @db.Text
    titleRomaji  String? @db.Text
    titleNative  String? @db.Text

    coverImage  String? @db.Text
    bannerImage String? @db.Text
    description String? @db.Text
    slug        String?

    status           String?
    originalCountry  String?
    originalLanguage String?
    averageRuntime   Int?
    firstAired       String?

    genres  String[] @db.Text
    studios String[] @db.Text

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    seasons  Json? @db.Json
    trailers Json? @db.Json

    contentRating String?

    locked          Boolean            @default(false)
    createdAt       DateTime           @default(now())
    updatedAt       DateTime           @updatedAt

    localPopularity         Int      @default(0)
    localFavoritesCount     Int      @default(0)
    localAverageScore       Float    @default(0)
    localStatusDistribution Json     @default("{}") @db.Json
