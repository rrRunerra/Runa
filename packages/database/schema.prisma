    role  String?
    order Int?

    movie     AquilaMovie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
    character AquilaCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
    actor     AquilaActor?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

    @@id([movieId, characterId])
    @@index([movieId])
    @@index([characterId])
    @@index([actorId])
}

model AquilaTvCharacter {
    tvId    Int
    characterId Int
    actorId     Int?

    role  String?
    order Int?

    tv    AquilaTv    @relation(fields: [tvId], references: [id], onDelete: Cascade)
    character AquilaCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
    actor AquilaActor?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

    @@id([tvId, characterId])
    @@index([tvId])
    @@index([characterId])
    @@index([actorId])
}

enum TvListStatus {
    WATCHING
    PLANNING
    COMPLETED
    ON_HOLD
    DROPPED
}

model AquilaTvUserList {
    id        Int          @id @default(autoincrement())
    username  String
    tvId      Int
    status    TvListStatus @default(PLANNING)
    score     Int?
    notes     String?      @db.Text
