{
  "type": "controller",
  "controllerName": "AuthController",
  "controllerCode": "AhCtr-",

  "dependedOn": "authService",

  "privateVars": [
    {
      "name": "authService",
      "type": "AuthService",
      "description": "Service used for user authentication, MFA, passkey, and login code operations",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "POST",
      "endpoint": "/auth/login",
      "handlerName": "login",
      "params": [
        {
          "name": "data",
          "source": "body",
          "type": "LoginAuthDto"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/mfa/send-email-code",
      "handlerName": "sendMfaEmailCode",
      "params": [
        {
          "name": "tempToken",
          "source": "body",
          "type": "string"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/mfa/device/send",
      "handlerName": "sendDeviceMfaCode",
      "params": [
        {
          "name": "tempToken",
          "source": "body",
          "type": "string"
        },
        {
          "name": "deviceId",
          "source": "body",
          "type": "string"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/mfa/verify",
      "handlerName": "verifyMfa",
      "params": [
        {
          "name": "tempToken",
          "source": "body",
          "type": "string"
        },
        {
          "name": "method",
          "source": "body",
          "type": "string"
        },
        {
          "name": "code",
          "source": "body",
          "type": "string",
          "optional": true
        },
        {
          "name": "passkeyResponse",
          "source": "body",
          "type": "any",
          "optional": true
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/passkey/login-options",
      "handlerName": "generatePasskeyLoginOptions",
      "params": [
        {
          "name": "identifier",
          "source": "body",
          "type": "string",
          "optional": true
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/passkey/login-verify",
      "handlerName": "verifyPasskeyLogin",
      "params": [
        {
          "name": "identifier",
          "source": "body",
          "type": "string"
        },
        {
          "name": "passkeyResponse",
          "source": "body",
          "type": "any"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/login-code/generate",
      "handlerName": "generateLoginCode",
      "params": [],
      "request": null,
      "public": true
    },
    {
      "method": "GET",
      "endpoint": "/auth/login-code/status",
      "handlerName": "getLoginCodeStatus",
      "params": [
        {
          "name": "code",
          "source": "query",
          "type": "string"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/auth/login-code/link",
      "handlerName": "linkLoginCode",
      "params": [
        {
          "name": "code",
          "source": "body",
          "type": "string"
        }
      ],
      "request": {
        "name": "req",
        "type": "Request & { user: { id: string } }"
      },
      "public": false
    }
  ]
}
