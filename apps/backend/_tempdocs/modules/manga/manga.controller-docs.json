{
  "type": "controller",
  "controllerName": "MangaController",
  "controllerCode": "MaCtr-",

  "dependedOn": "mangaService, cacheService",

  "privateVars": [
    {
      "name": "mangaService",
      "type": "MangaService",
      "description": "Service used for manga search, details lookup, and refresh operations",
      "readOnly": true
    },
    {
      "name": "cacheService",
      "type": "CacheService",
      "description": "Service used for cooldown caching of refresh requests",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "GET",
      "endpoint": "/manga/search",
      "handlerName": "search",
      "params": [
        {
          "name": "query",
          "source": "query",
          "type": "{ name: string }"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "GET",
      "endpoint": "/manga/details/:id",
      "handlerName": "getManga",
      "params": [
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/manga/refresh/:id",
      "handlerName": "refreshManga",
      "params": [
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": null,
      "public": false
    }
  ]
}
