{
  "type": "controller",
  "controllerName": "NotificationController",
  "controllerCode": "NoCtr-",

  "dependedOn": "notificationService",

  "privateVars": [
    {
      "name": "notificationService",
      "type": "NotificationService",
      "description": "Service used for notification CRUD and device approval operations",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "GET",
      "endpoint": "/notifications",
      "handlerName": "findAll",
      "params": [
        { "name": "skip", "source": "query", "type": "number", "optional": true },
        { "name": "take", "source": "query", "type": "number", "optional": true },
        { "name": "type", "source": "query", "type": "string", "optional": true },
        { "name": "status", "source": "query", "type": "string", "optional": true }
      ],
      "request": { "name": "req", "type": "any" },
      "public": false
    },
    {
      "method": "PUT",
      "endpoint": "/notifications/:id/status",
      "handlerName": "updateStatus",
      "params": [
        { "name": "id", "source": "param", "type": "string" },
        { "name": "body", "source": "body", "type": "UpdateNotificationStatusDto" }
      ],
      "request": { "name": "req", "type": "any" },
      "public": false
    },
    {
      "method": "POST",
      "endpoint": "/notifications/approve",
      "handlerName": "approveDevice",
      "params": [
        { "name": "body", "source": "body", "type": "ApproveDeviceDto" }
      ],
      "request": { "name": "req", "type": "any" },
      "public": false
    },
    {
      "method": "DELETE",
      "endpoint": "/notifications/:id",
      "handlerName": "delete",
      "params": [
        { "name": "id", "source": "param", "type": "string" }
      ],
      "request": { "name": "req", "type": "any" },
      "public": false
    },
    {
      "method": "DELETE",
      "endpoint": "/notifications",
      "handlerName": "deleteAll",
      "params": [],
      "request": { "name": "req", "type": "any" },
      "public": false
    }
  ]
}
