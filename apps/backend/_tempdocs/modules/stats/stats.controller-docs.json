{
  "type": "controller",
  "controllerName": "StatsController",
  "controllerCode": "StCtr-",

  "dependedOn": "prisma",

  "privateVars": [
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "prisma",
      "type": "PrismaService",
      "description": "Database service for stats lookup and privacy checks",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "GET",
      "endpoint": "/stats/:username/:mediaType",
      "handlerName": "getStats",
      "params": [
        {
          "name": "username",
          "source": "param",
          "type": "string"
        },
        {
          "name": "mediaType",
          "source": "param",
          "type": "string"
        },
        {
          "name": "req",
          "source": "body",
          "type": "any"
        }
      ],
      "request": {
        "name": "req",
        "type": "any"
      },
      "public": true
    }
  ]
}
