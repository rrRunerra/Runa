{
  "type": "controller",
  "controllerName": "PolarisController",
  "controllerCode": "PoCtr-",

  "dependedOn": "polarisService",

  "privateVars": [
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "polarisService",
      "type": "PolarisService",
      "description": "Service for Polaris bookmark CRUD operations",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "POST",
      "endpoint": "/polaris/bookmarks",
      "handlerName": "createOrUpdateBookmark",
      "params": [
        {
          "name": "req",
          "source": "body",
          "type": "any"
        },
        {
          "name": "dto",
          "source": "body",
          "type": "CreateBookmarkDto"
        }
      ],
      "request": {
        "name": "req",
        "type": "any"
      },
      "public": false
    },
    {
      "method": "GET",
      "endpoint": "/polaris/bookmarks",
      "handlerName": "getBookmarks",
      "params": [
        {
          "name": "req",
          "source": "body",
          "type": "any"
        }
      ],
      "request": {
        "name": "req",
        "type": "any"
      },
      "public": false
    },
    {
      "method": "DELETE",
      "endpoint": "/polaris/bookmarks/:id",
      "handlerName": "deleteBookmark",
      "params": [
        {
          "name": "req",
          "source": "body",
          "type": "any"
        },
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": {
        "name": "req",
        "type": "any"
      },
      "public": false
    }
  ]
}
