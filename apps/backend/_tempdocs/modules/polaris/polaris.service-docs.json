{
  "type": "service",
  "serviceName": "PolarisService",
  "serviceCode": "PoSve-",

  "dependedOn": "prisma",

  "privateVars": [
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "prisma",
      "type": "PrismaService",
      "description": "Database service for Polaris user bookmarks",
      "readOnly": true
    }
  ],

  "functions": [
    {
      "name": "createOrUpdateBookmark",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "dto",
          "type": "CreateBookmarkDto",
          "typeLib": "typescript"
        }
      ],
      "description": "Creates or updates a Polaris bookmark for a user. If a bookmark with the same name exists, updates it; otherwise creates a new one.",
      "returnValues": ["Promise<any>"],
      "exceptions": null
    },
    {
      "name": "getBookmarks",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Retrieves all bookmarks for a user, ordered by creation date descending",
      "returnValues": ["Promise<any[]>"],
      "exceptions": null
    },
    {
      "name": "deleteBookmark",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "id",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Deletes a bookmark by ID, ensuring it belongs to the requesting user",
      "returnValues": ["Promise<{ success: boolean }>"],
      "exceptions": [
        {
          "name": "rrNotFoundException",
          "rrCode": "PoSve-BWIDNF001",
          "message": "Bookmark with ID ${id} not found",
          "statusCode": 404
        }
      ]
    }
  ]
}
