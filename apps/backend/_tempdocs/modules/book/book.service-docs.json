{
  "type": "service",
  "serviceName": "BookService",
  "serviceCode": "BkSve-",

  "dependedOn": "bookRepository, bookQueueService",

  "privateVars": [
    {
      "name": "logger",
      "type": "Logger",
      "description": "Logger instance scoped to BookService",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "bookRepository",
      "type": "BookRepository",
      "description": "Repository used to read, write, and map book records",
      "readOnly": true
    },
    {
      "name": "bookQueueService",
      "type": "BookQueueService",
      "description": "Queue service used to schedule book refresh jobs",
      "readOnly": true
    }
  ],

  "functions": [
    {
      "name": "search",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "name",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Searches Google Books for books by name and maps the response to SearchMedia items",
      "returnValues": ["Promise<SearchMedia[]>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "BkSve-GBSF001",
          "message": "Google Books search failed: ${res.status}",
          "statusCode": 500
        }
      ]
    },
    {
      "name": "getBook",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "id",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "forceRefresh",
          "type": "boolean",
          "typeLib": "typescript",
          "optional": true,
          "default": false
        }
      ],
      "description": "Gets book data from cache/database when fresh enough, otherwise fetches from Google Books and queues a refresh job",
      "returnValues": ["Promise<Media>"],
      "exceptions": [
        {
          "name": "rrBadRequestException",
          "rrCode": "BkSve-IBF001",
          "message": "Invalid book ID format",
          "statusCode": 400
        },
        {
          "name": "rrNotFoundException",
          "rrCode": "BkSve-BNF001",
          "message": "Book with ID ${id} not found",
          "statusCode": 404
        }
      ]
    },
    {
      "name": "getRelatedBooks",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "id",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Fetches related books from Google Books by ID, with fallback to subject-based search",
      "returnValues": ["Promise<any[]>"],
      "exceptions": [
        {
          "name": "rrBadRequestException",
          "rrCode": "BkSve-IBF002",
          "message": "Invalid book ID format",
          "statusCode": 400
        },
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "BkSve-FTFRB001",
          "message": "Failed to fetch related books: ${res.status}",
          "statusCode": 500
        }
      ]
    },
    {
      "name": "getBookEditions",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "id",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Fetches alternative editions of a book by searching with title and author",
      "returnValues": ["Promise<any[]>"],
      "exceptions": [
        {
          "name": "rrBadRequestException",
          "rrCode": "BkSve-IBF003",
          "message": "Invalid book ID format",
          "statusCode": 400
        },
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "BkSve-FTFBE001",
          "message": "Failed to fetch book editions: ${res.status}",
          "statusCode": 500
        }
      ]
    },
    {
      "name": "cleanDescription",
      "type": "synch",
      "access": "private",
      "params": [
        {
          "name": "rawDesc",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Strips HTML tags and decodes HTML entities from raw description text",
      "returnValues": ["string"],
      "exceptions": null
    },
    {
      "name": "parseAuthorsAndArtists",
      "type": "synch",
      "access": "private",
      "params": [
        {
          "name": "info",
          "type": "any",
          "typeLib": "typescript"
        }
      ],
      "description": "Parses author/artist roles from Google Books volumeInfo, extracting by parenthetical role markers and fallback description matching",
      "returnValues": ["{ authors: string[]; artists: string[] }"],
      "exceptions": null
    },
    {
      "name": "fetchFromGoogleBooks",
      "type": "async",
      "access": "private",
      "params": [
        {
          "name": "id",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Fetches detailed book data from Google Books API and maps it to the Media shape",
      "returnValues": ["Promise<Media>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "BkSve-GBDFF001",
          "message": "Google Books detail fetch failed: ${res.status}",
          "statusCode": 500
        }
      ]
    }
  ]
}
