{
  "type": "controller",
  "controllerName": "TvController",
  "controllerCode": "TvCtr-",

  "dependedOn": "tvService, cacheService",

  "privateVars": [
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "tvService",
      "type": "TvService",
      "description": "Service used for TV show search, details lookup, and refresh operations",
      "readOnly": true
    },
    {
      "name": "cacheService",
      "type": "CacheService",
      "description": "Service used for cooldown caching of refresh requests",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "GET",
      "endpoint": "/tv/search",
      "handlerName": "search",
      "params": [
        {
          "name": "query",
          "source": "query",
          "type": "SearchTvDto"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "GET",
      "endpoint": "/tv/details/:id",
      "handlerName": "getTv",
      "params": [
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/tv/refresh/:id",
      "handlerName": "refreshTv",
      "params": [
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": null,
      "public": false
    }
  ]
}
