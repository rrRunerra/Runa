{
  "type": "service",
  "serviceName": "GameService",
  "serviceCode": "GeSve-",

  "dependedOn": "prisma, gameRepository, gameQueueService",

  "privateVars": [
    {
      "name": "logger",
      "type": "Logger",
      "description": "Logger instance scoped to GameService",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "prisma",
      "type": "PrismaService",
      "description": "Prisma database service",
      "readOnly": true
    },
    {
      "name": "gameRepository",
      "type": "GameRepository",
      "description": "Repository used to read, write, and map game records",
      "readOnly": true
    },
    {
      "name": "gameQueueService",
      "type": "GameQueueService",
      "description": "Queue service used to schedule game refresh jobs",
      "readOnly": true
    }
  ],

  "functions": [
    {
      "name": "getApiKey",
      "type": "synch",
      "access": "private",
      "params": [],
      "description": "Retrieves the RAWG_API_KEY from environment variables, logging a warning if not set",
      "returnValues": ["string"],
      "exceptions": null
    },
    {
      "name": "search",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "name",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Searches RAWG for games by name and maps the response to SearchMedia items",
      "returnValues": ["Promise<SearchMedia[]>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "GeSve-RSF001",
          "message": "RAWG search failed: ${res.status}",
          "statusCode": 500
        }
      ]
    },
    {
      "name": "getGame",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "id",
          "type": "number",
          "typeLib": "typescript"
        },
        {
          "name": "forceRefresh",
          "type": "boolean",
          "typeLib": "typescript",
          "optional": true,
          "default": false
        }
      ],
      "description": "Gets game data from cache/database when fresh enough, otherwise fetches from RAWG and queues a refresh job",
      "returnValues": ["Promise<Media>"],
      "exceptions": [
        {
          "name": "rrBadRequestException",
          "rrCode": "GeSve-IGI001",
          "message": "Invalid game ID: ${id}",
          "statusCode": 400
        },
        {
          "name": "rrNotFoundException",
          "rrCode": "GeSve-GWIDNF001",
          "message": "Game with ID ${id} not found",
          "statusCode": 404
        }
      ]
    },
    {
      "name": "fetchFromRawg",
      "type": "async",
      "access": "private",
      "params": [
        {
          "name": "id",
          "type": "number",
          "typeLib": "typescript"
        }
      ],
      "description": "Fetches detailed game data from RAWG API and maps it to the Media shape",
      "returnValues": ["Promise<Media>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "GeSve-RAKIND001",
          "message": "RAWG_API_KEY is not defined",
          "statusCode": 500
        },
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "GeSve-RDFF001",
          "message": "RAWG detail fetch failed: ${res.status}",
          "statusCode": 500
        }
      ]
    }
  ]
}
