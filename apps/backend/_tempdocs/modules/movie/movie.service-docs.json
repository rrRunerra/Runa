{
  "type": "service",
  "serviceName": "MovieService",
  "serviceCode": "MoSve-",

  "dependedOn": "prisma, movieRepository, movieQueueService",

  "privateVars": [
    {
      "name": "logger",
      "type": "Logger",
      "description": "Logger instance scoped to MovieService",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "token",
      "type": "string | null",
      "description": "Bearer token for TheTVDB API authentication, refreshed on expiry",
      "readOnly": false
    },
    {
      "name": "prisma",
      "type": "PrismaService",
      "description": "Prisma database service",
      "readOnly": true
    },
    {
      "name": "movieRepository",
      "type": "MovieRepository",
      "description": "Repository used to read, write, and map movie records",
      "readOnly": true
    },
    {
      "name": "movieQueueService",
      "type": "MovieQueueService",
      "description": "Queue service used to schedule movie refresh jobs",
      "readOnly": true
    }
  ],

  "functions": [
    {
      "name": "setTheTvDbToken",
      "type": "async",
      "access": "private",
      "params": [],
      "description": "Authenticates with TheTVDB API and stores the bearer token for subsequent requests",
      "returnValues": ["Promise<void>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "MoSve-AEI001",
          "message": "Auth error message from TheTVDB",
          "statusCode": 500
        }
      ]
    },
    {
      "name": "search",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "name",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Searches TheTVDB for movies by name and maps the response to SearchMedia items; re-authenticates on error",
      "returnValues": ["Promise<SearchMedia[]>"],
      "exceptions": null
    },
    {
      "name": "getMovie",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "id",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "forceRefresh",
          "type": "boolean",
          "typeLib": "typescript",
          "optional": true,
          "default": false
        }
      ],
      "description": "Gets movie data from cache/database when fresh enough, otherwise fetches from TheTVDB and queues a refresh job",
      "returnValues": ["Promise<Media>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "MoSve-IIF001",
          "message": "Invalid id format",
          "statusCode": 500
        },
        {
          "name": "rrNotFoundException",
          "rrCode": "MoSve-MNF001",
          "message": "Movie not found",
          "statusCode": 404
        }
      ]
    },
    {
      "name": "fetchFromTvdb",
      "type": "async",
      "access": "private",
      "params": [
        {
          "name": "tvdbId",
          "type": "number",
          "typeLib": "typescript"
        }
      ],
      "description": "Fetches detailed movie data (extended info + English translations) from TheTVDB API and maps it to the Media shape",
      "returnValues": ["Promise<Media>"],
      "exceptions": [
        {
          "name": "rrInternalServerErrorException",
          "rrCode": "MoSve-MWIDNF001",
          "message": "Movie with ID ${tvdbId} not found",
          "statusCode": 500
        }
      ]
    },
    {
      "name": "ensureMovie",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "tvdbId",
          "type": "number",
          "typeLib": "typescript"
        },
        {
          "name": "title",
          "type": "string",
          "typeLib": "typescript",
          "optional": true
        },
        {
          "name": "coverImage",
          "type": "string",
          "typeLib": "typescript",
          "optional": true
        }
      ],
      "description": "Ensures a movie record exists in the repository, fetching full data from TheTVDB or creating a minimal entry and queueing a job",
      "returnValues": ["Promise<any>"],
      "exceptions": null
    },
    {
      "name": "getRemoteIds",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "tvdbId",
          "type": "number",
          "typeLib": "typescript"
        }
      ],
      "description": "Fetches external remote IDs (TMDB, IMDb) for a movie from TheTVDB extended endpoint",
      "returnValues": ["Promise<{ tmdbId?: number; imdbId?: string } | null>"],
      "exceptions": null
    }
  ]
}
