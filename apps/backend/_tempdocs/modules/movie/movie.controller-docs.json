{
  "type": "controller",
  "controllerName": "MovieController",
  "controllerCode": "MoCtr-",

  "dependedOn": "movieService, cacheService",

  "privateVars": [
    {
      "name": "movieService",
      "type": "MovieService",
      "description": "Service used for movie search, details lookup, and refresh operations",
      "readOnly": true
    },
    {
      "name": "cacheService",
      "type": "CacheService",
      "description": "Service used for cooldown caching of refresh requests",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "GET",
      "endpoint": "/movie/search",
      "handlerName": "search",
      "params": [
        {
          "name": "query",
          "source": "query",
          "type": "{ name: string }"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "GET",
      "endpoint": "/movie/details/:id",
      "handlerName": "getMovie",
      "params": [
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "POST",
      "endpoint": "/movie/refresh/:id",
      "handlerName": "refreshMovie",
      "params": [
        {
          "name": "id",
          "source": "param",
          "type": "string"
        }
      ],
      "request": null,
      "public": false
    }
  ]
}
