{
  "type": "controller",
  "controllerName": "FavoriteController",
  "controllerCode": "FeCtr-",

  "dependedOn": "favoriteService",

  "privateVars": [
    {
      "name": "favoriteService",
      "type": "FavoriteService",
      "description": "Service used for favorite CRUD operations and media lookups",
      "readOnly": true
    },
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    }
  ],

  "routes": [
    {
      "method": "POST",
      "endpoint": "/favorites",
      "handlerName": "addFavorite",
      "params": [
        {
          "name": "dto",
          "source": "body",
          "type": "CreateFavoriteDto"
        }
      ],
      "request": {
        "name": "req",
        "type": "Request & { user: { id: string } }"
      },
      "public": false
    },
    {
      "method": "DELETE",
      "endpoint": "/favorites/:type/:mediaId",
      "handlerName": "removeFavorite",
      "params": [
        {
          "name": "type",
          "source": "param",
          "type": "string"
        },
        {
          "name": "mediaId",
          "source": "param",
          "type": "string"
        }
      ],
      "request": {
        "name": "req",
        "type": "Request & { user: { id: string } }"
      },
      "public": false
    },
    {
      "method": "GET",
      "endpoint": "/favorites",
      "handlerName": "getFavorites",
      "params": [
        {
          "name": "type",
          "source": "query",
          "type": "string",
          "optional": true
        }
      ],
      "request": {
        "name": "req",
        "type": "Request & { user: { id: string } }"
      },
      "public": false
    },
    {
      "method": "GET",
      "endpoint": "/favorites/user/:username",
      "handlerName": "getUserFavorites",
      "params": [
        {
          "name": "username",
          "source": "param",
          "type": "string"
        },
        {
          "name": "type",
          "source": "query",
          "type": "string",
          "optional": true
        }
      ],
      "request": null,
      "public": true
    },
    {
      "method": "GET",
      "endpoint": "/favorites/status/:type/:mediaId",
      "handlerName": "getFavoriteStatus",
      "params": [
        {
          "name": "type",
          "source": "param",
          "type": "string"
        },
        {
          "name": "mediaId",
          "source": "param",
          "type": "string"
        }
      ],
      "request": {
        "name": "req",
        "type": "Request & { user: { id: string } }"
      },
      "public": false
    }
  ]
}
