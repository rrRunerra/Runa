{
  "type": "service",
  "serviceName": "FavoriteService",
  "serviceCode": "FeSve-",

  "dependedOn": "prisma",

  "privateVars": [
    {
      "name": "moduleCode",
      "type": "string",
      "description": "Prefix for rrCodes",
      "readOnly": true
    },
    {
      "name": "prisma",
      "type": "PrismaService",
      "description": "Prisma database service for favorite CRUD operations and media lookups",
      "readOnly": true
    }
  ],

  "functions": [
    {
      "name": "addFavorite",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "dto",
          "type": "CreateFavoriteDto",
          "typeLib": "typescript"
        }
      ],
      "description": "Adds a favorite for the user. Returns the existing favorite if already present.",
      "returnValues": ["Promise<Favorite>"],
      "exceptions": null
    },
    {
      "name": "removeFavorite",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "type",
          "type": "FavoriteType",
          "typeLib": "typescript"
        },
        {
          "name": "mediaId",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Removes a favorite by composite key. Throws if not found.",
      "returnValues": ["Promise<{ success: boolean }>"],
      "exceptions": [
        {
          "name": "rrNotFoundException",
          "rrCode": "FeSve-FNF001",
          "message": "Favorite not found",
          "statusCode": 404
        }
      ]
    },
    {
      "name": "getFavorites",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "type",
          "type": "FavoriteType",
          "typeLib": "typescript",
          "optional": true
        }
      ],
      "description": "Gets all favorites for a user, optionally filtered by type, ordered by creation date descending",
      "returnValues": ["Promise<Favorite[]>"],
      "exceptions": null
    },
    {
      "name": "getFavoriteStatus",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "userId",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "type",
          "type": "FavoriteType",
          "typeLib": "typescript"
        },
        {
          "name": "mediaId",
          "type": "string",
          "typeLib": "typescript"
        }
      ],
      "description": "Checks whether a specific media item is favorited by the user",
      "returnValues": ["Promise<{ favorited: boolean }>"],
      "exceptions": null
    },
    {
      "name": "getFavoritesByUsername",
      "type": "async",
      "access": "public",
      "params": [
        {
          "name": "username",
          "type": "string",
          "typeLib": "typescript"
        },
        {
          "name": "type",
          "type": "FavoriteType",
          "typeLib": "typescript",
          "optional": true
        }
      ],
      "description": "Gets favorites for a user by username, resolving media details (title and image) from the appropriate media tables",
      "returnValues": ["Promise<{ id: string; userId: string; type: FavoriteType; mediaId: string; createdAt: Date; title: string; image: string }[]>"],
      "exceptions": [
        {
          "name": "rrNotFoundException",
          "rrCode": "FeSve-UNF001",
          "message": "User ${username} not found",
          "statusCode": 404
        }
      ]
    }
  ]
}
