{
  "type": "interceptor",
  "interceptorName": "LoggingInterceptor",

  "dependedOn": "Logger",

  "privateVars": [
    {
      "name": "logger",
      "type": "Logger",
      "description": "NestJS logger instance scoped to 'API'"
    }
  ],

  "functions": [
    {
      "name": "intercept",
      "type": "synch",
      "params": [
        {
          "name": "context",
          "type": "ExecutionContext",
          "typeLib": "@nestjs/common"
        },
        {
          "name": "next",
          "type": "CallHandler",
          "typeLib": "@nestjs/common"
        }
      ],
      "description": "Intercepts HTTP requests and logs request/response details and errors in development mode",
      "returnValues": ["Observable<unknown>"],
      "exceptions": null
    }
  ]
}
