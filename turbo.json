{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "db:generate": {
      "cache": true,
      "inputs": ["schema.prisma"],
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL", "NEXT_PUBLIC_URL", "NEXTAUTH_URL", "NEXT_PUBLIC_API_URL", "NEST_PORT", "NEXTAUTH_SECRET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    }
  }
}
